MONGODB_URI=mongodb://127.0.0.1:27017/khatma
PORT=3000

# SMTP provider credentials (copy these from your email provider settings).
# SMTP_SECURE is usually false for port 587 and true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Generate two different values locally; each must contain at least 32 bytes.
JWT_SECRET=
OTP_PEPPER=
